<h1>Professor</h1>
<a href="/professors/add" class="btn btn-success mb-3">Add Professor</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Materia</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <% professors.forEach(professor => { %>
        <tr>
            <td><%= professor.id %></td>
            <td><%= professor.nome %></td>
            <td><%= professor.valor %></td>
            <td><%= professor.materia.nome %></td>
            <td>
                <a href="/professors/edit/<%= professor.id %>"
                    class="btn btn-primary btn-sm">Editar</a>
                <form action="/professors/delete/<%= professor.id %>" method="POST"
                    class="d-inline">
                    <button type="submit"
                        class="btn btn-danger btn-sm">Delete</button>
                </form>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>
