<h1>Editar professor</h1>
<form action="/professor/edit/<%= professor.id %>" method="POST">
    <div class="form-group">
        <label for="nome">professor</label>
        <input type="text" class="form-control" id="nome" name="nome"
            value="<%= professor.nome %>" required>
    </div>
    <div class="form-group">
        <label for="materia">materia</label>
        <select class="form-control" id="materia" name="materiaId" required>
            <% materias.forEach(materia => { %>
            <option value="<%= materia.id %>" <%=materia.id ===
                professor.materiaId ? 'selected' : '' %>>
                <%= materia.nome %>
            </option>
            <% }) %>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Atualizar</button>
</form>
