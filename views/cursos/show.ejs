<h1>Cursos</h1>
<a href="/cursos/add" class="btn btn-success mb-3">Adicionar curso</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <% cursos.forEach(cursos => { %>
        <tr>
            <td><%= cursos.cursoId %></td>
            <td><%= cursos.nome %></td>
            <td>
                <a href="/cursos/edit/<%= cursos.cursoId %>"
                    class="btn btn-primary btn-sm">Editar</a>
                <form action="/cursos/delete/<%= cursos.cursoId %>"
                    method="POST" class="d-inline">
                    <button type="submit"
                        class="btn btn-danger btn-sm">Delete</button>
                </form>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>
